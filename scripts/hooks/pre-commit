#!/bin/sh
# Privacycontrole op wat je gaat committen (staged bestanden).
# Aanzetten: git config core.hooksPath scripts/hooks  (zie docs/ontwikkelen.md)
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v uv >/dev/null 2>&1; then
    exec uv run --no-project --quiet python scripts/privacy_check.py
fi
exec python3 scripts/privacy_check.py
